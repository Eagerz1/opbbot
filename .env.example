# ─────────────────────────────────────────────────────────────────────────────
#  OPB Giveaways — configuration
#
#  1. Copy this file to `.env`   (Windows: copy .env.example .env)
#  2. Fill in the two required values below
#  3. Run `npm run doctor` to check everything before starting
#
#  `.env` is gitignored — your token will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Discord Developer Portal → your app → Bot → Reset Token → Copy
# Looks like: MTIzNDU2Nzg5MDEyMzQ1Njc4.GxYzAb.aBcDeF...  (three parts, dot-separated)
# ⚠️ This is a password. Never share it or paste it into a screenshot.
DISCORD_TOKEN=

# Developer Portal → General Information → Application ID
# A 17-20 digit number.
CLIENT_ID=

# ─── RECOMMENDED ─────────────────────────────────────────────────────────────

# Your server's ID. With it, slash commands appear INSTANTLY in that server.
# Without it, they register globally and can take up to an hour to show up.
# To get it: Discord → User Settings → Advanced → Developer Mode ON,
#            then right-click your server icon → Copy Server ID
GUILD_ID=

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Shown as a clickable link on the Patreon tiers embed.
PATREON_URL=

# Where the database file lives. Defaults to ./data/opb.sqlite
# On a host with an ephemeral filesystem, point this at a persistent volume
# or you'll lose giveaways and XP on every redeploy.
DATABASE_PATH=

# Port for `npm run preview` (the local server-layout preview site).
PORT=3000
