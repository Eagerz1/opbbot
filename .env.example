# ─── Required ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=your_bot_token_here

# Application ID (same page → General Information → Application ID)
CLIENT_ID=your_application_id_here

# ─── Optional ────────────────────────────────────────────────────────────────
# Your server's ID. Set it while developing so `npm run deploy` registers
# commands instantly in that one server. Leave blank to register globally
# (global commands can take up to an hour to appear).
GUILD_ID=

# Shown as a link on the Patreon embed.
PATREON_URL=

# Where the SQLite file lives. Defaults to ./data/opb.sqlite
DATABASE_PATH=

# Port for `npm run preview` (the static server-layout preview site).
PORT=3000
